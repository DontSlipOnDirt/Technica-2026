# Copy to .env and fill in. Never commit the real .env.
NESSIE_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
# Optional: pin a Gemini model (default follows the newest Flash)
GEMINI_MODEL=gemini-flash-latest

# Backend (backend/server.py)
# The demo customer's Nessie checking account ID (from the data teammate's seed output)
NESSIE_ACCOUNT_ID=
ACCOUNT_NAME=Checking
# Names the customer can say -> Nessie account IDs, as JSON
DEMO_PAYEES={"Maria": "", "Bob": ""}
TRUSTED_CONTACT_NAME=Maria (daughter)
TRUSTED_CONTACT_PHONE=555-0100
# Comma-separated app origins allowed to call /api (empty = any)
ALLOWED_ORIGINS=
